---
import BaseLayout from '../layouts/BaseLayout.astro';
import PixelPortrait from '../components/PixelPortrait.astro';
---

<BaseLayout title="Home">
	<section id="home" class="page-selection hero-layout">
		<div class="hero-text-container">
			<h1 class="hero-title">Born for the Web.</h1>
			<p class="hero-subtitle">Est. June 12, 1989</p>
		</div>
	</section>
	<section class="newspaper-wrapper">
		<header class="masthead">
      <h1 class="edition-title">THE 1989 CHRONICLE</h1>
      <div class="edition-meta">
        <span>VOL. 37 NO. 12</span>
        <span>FINAL EDITION</span>
        <span>JUNE 12, 1989 — PRESENT</span>
      </div>
    </header>

		<main class="bento-grid">
			<article class="clipping lead-story col-span-2">
				<h2 class="clipping-title">
					BORN AT THE INTERSECTION
				</h2>
				<div class="clipping-content">
					<p class="drop-cap">
						On June 12, 1989, Born on the same day the blueprint for the World Wide Web was finalized. 
            I am a digital native in the truest sense; my evolution has mirrored the 
            evolution of the browser. I build software that respects this lineage 
            while pushing the boundaries of what’s next.
					</p>
				</div>
			</article>

			<article class="clipping legacy-blue row-span-2">
				<h2 class="clipping-title invert">
					DIGITAL LEGACY
				</h2>
				<div class="clipping-content">
					<div class="circuit-content"></div>
					<p>
						I build software that fulfills the promise of the digital-human future.
					</p>
					<a href="/projects" class="btn-newspaper">VIEW PROJECTS</a>
				</div>
			</article>

			<article class="clipping sidebar">
				<ul class="date-list">
					<li><strong>MARCH 1989:</strong> WEB PROPOSAL</li>
          <li><strong>JUNE 1989:</strong> MY BIRTH / NEXTSTEP OS</li>
          <li><strong>1991:</strong> WORLD WIDE WEB</li>
				</ul>
			</article>

			<article class="clipping terminal-box">
				<div class="terminal-screen">
					<code>C:\>CODE_THE_FUTURE</code>
				</div>
			</article>

			<article class="clipping portrait-frame row-span-2">
				<PixelPortrait src="/images/my-pixel-avatar.png" name="GREGORY ROTHSTEIN" />
			</article>

			<article class="clipping philosophy col-span-1">
				<h2 class="clipping-title">
					CODE PHILOSOPHY
				</h2>
				<div class="icon-stack">📚</div>
				<p class="mono-label">TECH STACK</p>
			</article>

			<article class="clipping center-align">
				<div class="icon-globe">🌐</div>
				<p class="mono-label">GLOBAL IMPACT</p>
			</article>

			<article class="clipping contact-box">
				<div class="icon-chat">💬</div>
				<p class="mono-label">HUMAN-CENTERED DESIGN</p>
			</article>
		</main>
	</section>

	<section class="newspaper-wrapper">
		<header class="masthead">
			<h1 class="edition-title">THE BUILDER'S GAZETTE</h1>
			<div class="edition-meta">
				<span>VOL. 37 NO. 13</span>
				<span>SPECIAL REPORT</span>
				<span>ARCHIVED WORKS</span>
			</div>
		</header>

		<main class="bento-grid">
			<article class="clipping col-span-2 row-span-2">
				<h2 class="clipping-title">FEATURED: PROJECT NEON</h2>
				<div class="clipping-content">
					<p>A revolutionary approach to digital aesthetics. Reimagining the interface between human and machine with pixel-perfect precision.</p>
					<div class="placeholder-img"></div>
					<a href="/projects" class="btn-newspaper">READ FULL REPORT</a>
				</div>
			</article>

			<article class="clipping">
				<h3 class="clipping-title" style="font-size: 1.2rem;">LATEST COMMITS</h3>
				<ul class="date-list">
					<li><strong>FEAT:</strong> DARK MODE</li>
					<li><strong>FIX:</strong> HERO TYPO</li>
					<li><strong>CHORE:</strong> DEPS UPDATE</li>
				</ul>
			</article>

			<article class="clipping legacy-blue">
				<h3 class="clipping-title invert" style="font-size: 1.2rem;">TECH RADAR</h3>
				<p>React, Astro, TypeScript</p>
			</article>

			<article class="clipping col-span-2 center-align">
				<p class="mono-label">SEE ALL 42 REPOSITORIES</p>
			</article>
		</main>
	</section>

	<section class="newspaper-wrapper">
		<header class="masthead">
			<h1 class="edition-title">THE ANALYTICAL POST</h1>
			<div class="edition-meta">
				<span>VOL. 37 NO. 14</span>
				<span>OPINION</span>
				<span>THE WHY</span>
			</div>
		</header>

		<main class="bento-grid">
			<article class="clipping col-span-2 row-span-2">
				<h2 class="clipping-title">PURPOSE OVER PATTERNS</h2>
				<div class="clipping-content">
					<p class="drop-cap">Why do we build? Not just to fill screens with pixels, but to solve real human problems. My approach is rooted in the belief that technology should be invisible, intuitive, and indispensable.</p>
					<p>Every project starts with a question: "Why does this exist?" The answer drives the architecture.</p>
				</div>
			</article>

			<article class="clipping col-span-2">
				<h3 class="clipping-title" style="font-size: 1.2rem;">THE PROCESS</h3>
				<p><strong>1. DISCOVER:</strong> Uncover the root problem.</p>
				<p><strong>2. DESIGN:</strong> Prototype the solution.</p>
				<p><strong>3. DEPLOY:</strong> Ship with confidence.</p>
			</article>

			<article class="clipping legacy-blue col-span-2">
				<h3 class="clipping-title invert" style="font-size: 1.2rem;">CORE BELIEFS</h3>
				<p>Simplicity is the ultimate sophistication.</p>
			</article>
		</main>
	</section>

	<section class="newspaper-wrapper">
		<header class="masthead">
			<h1 class="edition-title">THE DAILY CONNECT</h1>
			<div class="edition-meta">
				<span>VOL. 37 NO. 15</span>
				<span>CLASSIFIEDS</span>
				<span>INQUIRIES OPEN</span>
			</div>
		</header>

		<main class="bento-grid">
			<article class="clipping col-span-3">
				<h2 class="clipping-title">SEEKING COLLABORATION</h2>
				<div class="clipping-content">
					<p class="drop-cap">Are you building the future? I am currently accepting new contracts and full-time opportunities. Let's discuss architecture, design, and implementation.</p>
				</div>
			</article>

			<article class="clipping contact-box row-span-2">
				<h2 class="clipping-title">CONTACT</h2>
				<div class="icon-chat">✉️</div>
				<p><strong>EMAIL:</strong><br>hello@example.com</p>
				<p><strong>SOCIAL:</strong><br>@gregoryrothstein</p>
			</article>

			<article class="clipping col-span-3 center-align">
				<h2 class="clipping-title" style="margin-bottom:0;">THANKS FOR READING</h2>
				<p class="mono-label">END OF TRANSMISSION</p>
			</article>
		</main>
	</section>
</BaseLayout>

<style>
	/* Home Page: Hero Layout */
	.hero-layout {
		text-align: center;
		align-items: center;
		gap: 3rem;
	}

	.hero-title {
		font-family: var(--font-serif);
		font-size: clamp(3rem, 8vw, 6rem);
		line-height: 0.9;
	}

	.hero-subtitle {
		font-family: var(--font-mono);
		font-size: 1rem;
		letter-spacing: 3px;
		margin-top: 1rem;
		text-transform: uppercase;
	}

	/* Home Page: About Section */
	.home-about {
    padding: 4rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
    min-height: 80vh;
    display: flex;
    align-items: center;
  }

	/* Bento Grid Container */
  .bento-grid {
		display: grid;
  	grid-template-columns: repeat(4, 1fr);
  	grid-auto-rows: minmax(150px, auto);
  	gap: 10px; /* Tight gaps like newspaper columns */
  	background: var(--ink); /* This creates the "lines" between boxes */
  	padding: 10px;
  	border: 2px solid var(--ink);
  }

	/* Grid spanning */
	.col-span-2 {
		grid-column: span 2;
	}
	.col-span-3 {
		grid-column: span 3;
	}
	.row-span-2 {
		grid-row: span 2;
	}

	/* Newspaper Clipping */
	.newspaper-wrapper {
		display: flex;
		flex-direction: column;
		padding-bottom: 3rem;
		padding-left: 5rem;
		padding-right: 5rem;
	}

	@media (max-width: 768px) {
		.newspaper-wrapper {
			padding-left: 1rem;
			padding-right: 1rem;
		}
		.bento-grid {
			grid-template-columns: 1fr;
		}
		.col-span-2, .col-span-3, .row-span-2 {
			grid-column: auto;
			grid-row: auto;
		}
	}

	.clipping {
		display: flex;
		flex-direction: column;
		background: var(--off-white);
		padding: 1.5rem;
		position: relative;
		overflow: hidden;
		border: 1px solid var(--ink);
  	box-shadow: 2px 2px 0px rgba(0,0,0,0.05); /* Soft shadow for paper depth */
	}

	.clipping:hover {
		transform: scale(1.01) rotate(0.2deg);
		box-shadow: 8px 8px 0px var(--ink);
		z-index: 10;
		transition: all 0.2s ease-out;
	}

	.legacy-blue {
		background: #008080;
		color: white;
		text-align: center;
	}

	.btn-newspaper {
		display: inline-block;
		background: var(--ink);
		color: var(--off-white);
		padding: 0.5rem 1rem;
		text-decoration: none;
		font-family: var(--font-mono);
		font-weight: bold;
		margin-top: 1rem;
		text-transform: uppercase;
	}

	.clipping-title {
		font-family: var(--font-serif);
		font-size: 1.8rem;
		margin-bottom: 1rem;
		font-weight: 900;
		text-transform: uppercase;
	}

	.clipping-title.invert {
		background: var(--ink);
		color: var(--off-white);
		padding: 5px;
		display: inline-block;
	}

	/* Some boxes get a thicker "headline" top border */
	.lead-story {
		border-top: 5px solid var(--ink);
	}

	/* Horizontal Rule for that newspaper look */
	.clipping-content::after {
		content: "";
		display: block;
		width: 50px;
		height: 1px;
		background: var(--ink);
		margin: 1rem auto;
	}

	.portrait-frame {
		border: 4px solid #ff00ff;
		padding: 10px;
		text-align: center;
	}

	.name-plate {
		background: var(--ink);
		color: var(--off-white);
		font-family: var(--font-mono);
		margin-top: 10px;
		padding: 5px;
	}

	.drop-cap {
		font-family: var(--font-mono);
	}

	.drop-cap::first-letter {
		font-family: var(--font-serif);
		font-size: 4rem;
		float: left;
		line-height: 0.8;
		margin-right: 8px;
		color: var(--ink);
		font-weight: 900;
	}

	.placeholder-img {
		width: 100%;
		height: 100px;
		background: repeating-linear-gradient(45deg, #ccc, #ccc 10px, #eee 10px, #eee 20px);
		border: 1px solid var(--ink);
		margin: 1rem 0;
	}

	.mono-label {
		font-family: var(--font-mono);
		letter-spacing: -0.5px;
		word-spacing: -2px;
		text-transform: uppercase;
		font-size: 0.75rem;
	}
</style>