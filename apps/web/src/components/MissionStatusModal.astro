---
/* MissionStatusModal.astro */
import WireDispatchPuzzle from "./WireDispatchPuzzle.astro";
import HexTeletypePuzzle from "./HexTeletypePuzzle.astro";
import EditorialRedactionPuzzle from "./EditorialRedactionPuzzle.astro";
---

<div id="mission-status-modal">
  <div class="modal-card" id="mission-status-modal-card">
    <!-- Screen 1: Mission Status Overview -->
    <div id="screen-status-overview" class="modal-screen">
      <h2 class="modal-header">MISSION CONTROL: STATUS</h2>

      <div class="modal-text">
        <p>
          Your current objective is to collect three hidden keys to unlock the
          Classified Archive.
        </p>
        <p>
          <strong>CURRENT STATUS:</strong>
          <span id="modal-key-count">0</span>/3 KEYS COLLECTED
        </p>

        <h3>Collected Keys:</h3>
        <ul class="clue-list">
          <li id="key-slot-1">
            Key 1: <span class="key-value">[PENDING]</span>
          </li>
          <li id="key-slot-2">
            Key 2: <span class="key-value">[PENDING]</span>
          </li>
          <li id="key-slot-3">
            Key 3: <span class="key-value">[PENDING]</span>
          </li>
        </ul>
      </div>

      <div class="modal-actions">
        <button id="open-wire-puzzle-btn" class="btn btn-secondary">
          CASE FILE 01
        </button>
        <button id="open-hex-puzzle-btn" class="btn btn-secondary">
          CASE FILE 02
        </button>
        <button id="open-redaction-puzzle-btn" class="btn btn-secondary">
          CASE FILE 03
        </button>
        <button id="close-status-modal-btn" class="btn btn-secondary">
          CLOSE
        </button>
      </div>
    </div>

    <div id="screen-wire-puzzle" class="modal-screen hidden">
      <WireDispatchPuzzle />
      <div class="modal-actions">
        <button id="back-from-wire-puzzle-btn" class="btn btn-secondary">
          BACK TO STATUS
        </button>
      </div>
    </div>

    <div id="screen-hex-puzzle" class="modal-screen hidden">
      <HexTeletypePuzzle />
      <div class="modal-actions">
        <button id="back-from-hex-puzzle-btn" class="btn btn-secondary">
          BACK TO STATUS
        </button>
      </div>
    </div>

    <div id="screen-redaction-puzzle" class="modal-screen hidden">
      <EditorialRedactionPuzzle />
      <div class="modal-actions">
        <button id="back-from-redaction-puzzle-btn" class="btn btn-secondary">
          BACK TO STATUS
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  function initMissionStatusModal() {
    const modal = document.getElementById("mission-status-modal");
    const statusScreen = document.getElementById("screen-status-overview");
    const wirePuzzleScreen = document.getElementById("screen-wire-puzzle");
    const hexPuzzleScreen = document.getElementById("screen-hex-puzzle");
    const redactionPuzzleScreen = document.getElementById(
      "screen-redaction-puzzle",
    );

    const triggerBtn = document.getElementById("trigger-mission-modal");
    const openWirePuzzleBtn = document.getElementById("open-wire-puzzle-btn");
    const openHexPuzzleBtn = document.getElementById("open-hex-puzzle-btn");
    const openRedactionPuzzleBtn = document.getElementById(
      "open-redaction-puzzle-btn",
    );
    const backFromWirePuzzleBtn = document.getElementById(
      "back-from-wire-puzzle-btn",
    );
    const backFromHexPuzzleBtn = document.getElementById(
      "back-from-hex-puzzle-btn",
    );
    const backFromRedactionPuzzleBtn = document.getElementById(
      "back-from-redaction-puzzle-btn",
    );
    const closeBtn = document.getElementById("close-status-modal-btn");

    if (!modal) return;

    const showModal = (screenToShow: HTMLElement) => {
      statusScreen?.classList.add("hidden");
      wirePuzzleScreen?.classList.add("hidden");
      hexPuzzleScreen?.classList.add("hidden");
      redactionPuzzleScreen?.classList.add("hidden");
      screenToShow.classList.remove("hidden");
      modal.classList.add("visible");
    };

    const closeModal = () => {
      modal.classList.remove("visible");
    };

    // Open this modal to the status screen
    triggerBtn?.addEventListener("click", () => showModal(statusScreen!));
    openWirePuzzleBtn?.addEventListener("click", () =>
      showModal(wirePuzzleScreen!),
    );
    openHexPuzzleBtn?.addEventListener("click", () =>
      showModal(hexPuzzleScreen!),
    );
    openRedactionPuzzleBtn?.addEventListener("click", () =>
      showModal(redactionPuzzleScreen!),
    );
    backFromWirePuzzleBtn?.addEventListener("click", () =>
      showModal(statusScreen!),
    );
    backFromHexPuzzleBtn?.addEventListener("click", () =>
      showModal(statusScreen!),
    );
    backFromRedactionPuzzleBtn?.addEventListener("click", () =>
      showModal(statusScreen!),
    );
    closeBtn?.addEventListener("click", closeModal);

    // This ensures the key count displayed in the modal updates
    window.addEventListener("update-key-count", (event) => {
      const customEvent = event as CustomEvent;
      const keyCountSpan = document.getElementById("modal-key-count");
      if (keyCountSpan) {
        keyCountSpan.textContent = customEvent.detail.count;
      }
      // You might also update individual key slots here if you store them.
    });
  }

  // Setup on initial load and after Astro view transitions
  document.addEventListener("astro:page-load", initMissionStatusModal);
</script>
<style>
  #mission-status-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(4px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s ease;
  }

  #mission-status-modal.visible {
    opacity: 1;
    pointer-events: auto;
  }

  .modal-card {
    background-color: #f4f1ea;
    padding: 2rem;
    max-width: 30rem;
    width: 90%;
    border: 4px solid #222;
    font-family: var(--font-mono);
    max-height: 85vh;
    overflow-y: auto;
    box-shadow: 10px 10px 0px rgba(0, 0, 0, 0.2);
  }

  .modal-header {
    font-size: 1.5rem;
    font-weight: bold;
    text-transform: uppercase;
    border-bottom: 2px solid black;
    margin-bottom: 1rem;
  }

  .modal-text p {
    margin-bottom: 1.25rem;
    line-height: 1.5;
  }

  .clue-list {
    list-style: none;
    margin: 1rem 0;
    padding: 1rem;
    background: rgba(0, 0, 0, 0.05);
    border: 1px dashed #222;
  }

  .key-value {
    color: #b91c1c;
    font-weight: bold;
  }

  .key-input {
    width: 100%;
    padding: 0.75rem;
    background: #fff;
    border: 2px solid #222;
    font-family: var(--font-mono);
    margin-bottom: 0.5rem;
  }

  .key-feedback {
    font-size: 0.8rem;
    min-height: 1.2rem;
    color: #b91c1c;
  }

  .modal-actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .btn {
    padding: 0.75rem 1rem;
    text-transform: uppercase;
    font-weight: bold;
    cursor: pointer;
    font-family: var(--font-mono);
    transition: all 0.2s;
  }

  .btn-primary {
    background-color: black;
    color: white;
    border: none;
  }
  .btn-primary:hover {
    background-color: #b91c1c;
  }

  .btn-secondary {
    background-color: transparent;
    color: black;
    border: 1px solid black;
  }
  .btn-secondary:hover {
    background-color: #ddd;
  }
</style>
